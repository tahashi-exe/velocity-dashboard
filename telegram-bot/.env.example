# For running the bot on your own machine (npm start). The deployed bot does
# not read this file: its values are set as Edge Function secrets in the
# Supabase dashboard (supabase/SETUP.md Part 5).

# Get this from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Your *numeric* personal chat ID, discovered with npm run discover-chat-id.
TELEGRAM_ADMIN_CHAT_ID=

# Create a GitHub fine-grained token with Contents: Read and write permission
# for only the Velocity repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-github-user/velocity-ae

# Optional. Defaults to main.
GITHUB_BRANCH=main

# Optional. Where half-finished entries are saved so a restart resumes.
# Defaults to a file in the system temp directory.
DRAFTS_FILE=

# Optional. Set both to also save every publish to the app's database.
# The secret key can edit every table: keep it here only, never in the
# website's code. Leave both blank to write to GitHub only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

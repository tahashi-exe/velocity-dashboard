# Get this from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Your *numeric* personal chat ID, discovered with npm run discover-chat-id.
TELEGRAM_ADMIN_CHAT_ID=

# Create a GitHub fine-grained token with Contents: Read and write permission
# for only the Velocity repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-github-user/velocity-ae
GITHUB_BRANCH=main

# Create this at platform.openai.com. It is used only by the bot process.
OPENAI_API_KEY=

# Optional. gpt-5 supports both text/image input and structured output.
OPENAI_MODEL=gpt-5

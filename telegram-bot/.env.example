# Get this from @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=

# Your *numeric* personal chat ID, discovered with npm run discover-chat-id.
TELEGRAM_ADMIN_CHAT_ID=

# Create a GitHub fine-grained token with Contents: Read and write permission
# for only the Velocity repository.
GITHUB_TOKEN=
GITHUB_REPOSITORY=your-github-user/velocity-ae

# Optional. Defaults to main.
GITHUB_BRANCH=main

# Optional. Where half-finished entries are saved so a restart resumes.
# Defaults to a file in the system temp directory. Point this at a mounted
# volume if you want drafts to survive Railway redeploys too.
DRAFTS_FILE=
